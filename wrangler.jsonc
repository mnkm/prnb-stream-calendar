{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prnb-youtube-calendar",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // workers.dev の URL(prnb-youtube-calendar.<アカウント>.workers.dev)を閉じる。入口は、プロキシの Worker からの
  // サービスバインディング(https://mnkm.page/prnb-stream-calendar/)だけにする。
  // preview_urls を書いていないので、本番のバージョンごとの URL(<バージョン>-prnb-youtube-calendar.…)も
  // 一緒に閉じる(preview_urls の既定は workers_dev と同じ値)。ブランチのプレビュー(下の previews)は別の仕組み
  "workers_dev": false,
  // ログ。コードが console で出すもの(同期の結果、エラー)は記録する。リクエスト 1 件ごとに自動で記録されるログ
  // (invocation logs)は止める(ログの量を抑えるため)
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },

  // React SPA の配信。/api/* だけ Worker(Hono)で処理する。
  // 存在しないパスには 404(public/404.html)を返す。画面はパスを持たない(状態はクエリだけ)ので、どのパスにも
  // index.html を返す設定(single-page-application)は要らない。そのうえ、画面のファイルと API は相対指定
  // (vite.config.ts の base)なので、「/foo/bar」に index.html を返すと「/foo/assets/…」を読みに行って真っ白になる
  "assets": {
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prnb-youtube-calendar",
      "database_id": "135d926c-0427-409d-8fcd-ab3d296bcc63",
      "migrations_dir": "migrations"
    }
  ],

  // 公開 API のレート制限(1 つの IP から 1 分間に受け付ける回数。src/worker/index.ts)。
  // 検索はデータベースを全件読むので、キャッシュに無い検索はさらに少なく抑える。
  // namespace_id はアカウントの中で重ならない任意の数。数える単位は Cloudflare の拠点ごとなので、厳密な上限でもない
  "ratelimits": [
    { "name": "API_LIMITER", "namespace_id": "1001", "simple": { "limit": 200, "period": 60 } },
    { "name": "SEARCH_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],

  // 毎分動かす。5 分に 1 回は全体の同期(全チャンネルの差分同期など)、それ以外の回は、配信の開始・終了だけを見る
  // 軽い確認(src/worker/index.ts の scheduled)。Workers Paid プランが前提(CPU 時間・サブリクエストの上限)。
  // Cron の設定は、GitHub 連携の自動デプロイでは本番に反映されない。変えたときは、手元で
  // 「npm run build」のあと「npx wrangler triggers deploy」を実行する
  "triggers": { "crons": ["* * * * *"] },

  // セトリの点検で、問題が見つかったときに Issue を作るリポジトリ
  "vars": { "GITHUB_REPO": "mnkm/prnb-youtube-calendar" },

  // main 以外のブランチの push で Workers Builds が作るプレビュー(wrangler preview)の設定。
  // Wrangler 4.147 からこの項目が無いとプレビューのビルドが失敗する。D1 などはプレビューに引き継がれないので、
  // プレビューは本番のデータベースを読み書きしない(API は動かず、画面の確認だけに使える)
  "previews": {}

  // シークレット(コミットしない):
  //   YOUTUBE_API_KEY … YouTube Data API v3 の API キー
  //   ADMIN_TOKEN     … POST /api/admin/sync 用のトークン
  //   TWITCH_CLIENT_ID / TWITCH_CLIENT_SECRET … Twitch のアプリの Client ID と Client Secret。無ければ Twitch は同期しない
  //   GITHUB_TOKEN    … セトリの点検の Issue を作るトークン(このリポジトリの Issues の読み書きだけを許可)。無ければ通知しない
}
