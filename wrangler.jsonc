{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prnb-youtube-calendar",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // React SPA の配信。/api/* だけ Worker(Hono)で処理する
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prnb-youtube-calendar",
      "database_id": "135d926c-0427-409d-8fcd-ab3d296bcc63",
      "migrations_dir": "migrations"
    }
  ],

  // 15 分ごとに YouTube と同期
  "triggers": { "crons": ["*/15 * * * *"] }

  // シークレット(コミットしない):
  //   YOUTUBE_API_KEY … YouTube Data API v3 の API キー
  //   ADMIN_TOKEN     … POST /api/admin/sync 用のトークン
}
